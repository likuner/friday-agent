# 智谱开放平台密钥（必填，联网搜索 / 医学文献检索依赖）：https://open.bigmodel.cn/
ZHIPU_API_KEY=

# GLM 联网检索参数（不配则用默认值）
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-5.3-flash
# 搜索引擎：search_std（0.01元/次）/ search_pro（0.03元/次，质量更好）
# GLM_SEARCH_ENGINE=search_std

# ===== 本地 Elasticsearch（med-es 容器，TLS + basic auth；medical_rag_search 依赖）=====
# ES 未启动时工具返回可读错误，不影响其他工具
# ES_URL=https://localhost:9200
# ES_USERNAME=elastic
# ES_PASSWORD=
# 自签证书默认不校验
# ES_VERIFY_CERTS=false
# ES_INDEX=medical_chunks
# 检索调参（不配则用默认值）：召回深度 / 融合候选数 / 最终保留条数
# RAG_RECALL_K=20
# RAG_CANDIDATE_K=10
# RAG_TOP_K=3

# 传输方式：stdio（本地客户端默认）/ http（供 backend 等远程消费方接入）
# MCP_TRANSPORT=stdio
# 仅 http 模式生效；默认只绑回环地址。外网部署前必读 README「外网部署检查清单」
# MCP_HOST=127.0.0.1
# MCP_PORT=8806

# http 模式鉴权 token（Bearer）。生成方式：openssl rand -hex 32
# 支持逗号分隔多个值：token 轮换时先新旧并存，消费方全部切换后再删除旧值（零停机）
# 留空则 http 模式不鉴权，仅建议配合默认回环地址使用；stdio 模式不受影响
# MCP_AUTH_TOKEN=
