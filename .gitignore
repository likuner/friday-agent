# ===== 环境变量 / 密钥（绝不提交）=====
# 注意：规则顺序有意义，先忽略所有 .env*，再显式放行 .env.example
.env
.env.*
!.env.example
*.pem
*.key

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== 运行期数据 =====
# 一键启动脚本的 PID / 导入检查产物
.run/

# mimosa 安全扫描插件的工作数据（hook 基线快照 / 审查报告，按会话生成）
.mimosa/

# 日志（根 logs/ 统一收：滚动业务日志 + 控制台镜像 + eval 报告）
# 无前导斜杠的 logs/ 同时匹配任意子目录中的 logs
logs/
*.log

# 用户上传的图片（属于运行数据，不入库）
backend/files/

# 数据库文件
*.db
*.sqlite3
*.db-journal

# ===== Node / Next.js =====
node_modules/
.next/
out/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ===== 编辑器 / 系统 =====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
