APP_ENV=development
DATABASE_URL=postgresql+asyncpg://friday:friday@localhost:5432/friday_agent
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000

# ===== 模型 =====
# MODEL_PROVIDER=demo 时返回本地演示流，无需任何密钥；真正调用模型设为 deepseek
MODEL_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
# V4 系列：deepseek-chat/deepseek-reasoner 已于 2026-07-24 退役
OPENAI_MODEL=deepseek-v4-pro
# 深度思考模型，需支持 reasoning（V4 系列均原生支持）；留空则退化为提示词引导
OPENAI_THINKING_MODEL=deepseek-v4-pro

# ===== 医学 RAG（本地 Elasticsearch 混合检索，见项目根 README）=====
ZHIPU_API_KEY=
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
# 需与文献语料入库时的维度一致
EMBEDDING_DIMENSIONS=1024
# rerank 模型（智谱 rerank 接口，复用 ZHIPU_API_KEY / EMBEDDING_BASE_URL）
RERANK_MODEL=rerank

# 本地 Elasticsearch（med-es 容器，默认开 TLS + basic auth，自签证书不校验）
ES_URL=https://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=
ES_VERIFY_CERTS=false
ES_INDEX=medical_chunks
# 单路召回深度（应大于融合窗口）与 RRF 融合候选池（rerank 前），及 rerank 后最终保留条数
RAG_RECALL_K=20
RAG_CANDIDATE_K=10
RAG_TOP_K=3
# rerank 相关性分数阈值（0~1，0 表示不过滤）
RAG_MIN_SCORE=0.0

# 旧 pgvector 库：仅作 scripts/migrate_pg_to_es.py 的迁移数据源
MEDRAG_DB_URL=postgresql://meduser:medpass@localhost:5433/medrag

# ===== Agent 内置工具（Bash / 文件读写 / 任务规划）=====
# 服务端总开关：关闭后即使请求带 agent_tools=true 也不注册内置工具
AGENT_TOOLS_ENABLED=true
# 默认工作区根目录（每会话一个子目录，是写入自动放行区）
WORKSPACES_DIR=workspaces
# Bash 命令放行前缀（逗号分隔，子串匹配，如 open -a,osascript）：DONT_ASK 模式下
# 非白名单命令一律拒绝。仅建议本地开发使用——命令在后端所在机器执行，且对所有登录用户生效
AGENT_TOOLS_BASH_ALLOW_PREFIXES=
# 权限确认卡片无人应答的超时秒数（超时按「拒绝」续跑，流不会悬挂）
PERMISSION_CONFIRM_TIMEOUT_SECONDS=120

# ===== 多智能体协作（TeamPipeline：leader 规划派活 + 检索员/执行员执行）=====
# 服务端总开关：关闭后即使请求带 multi_agent=true 也走单 Agent；紧急情况一键回退
MULTI_AGENT_ENABLED=true

# ===== 可观测：OpenTelemetry 追踪 =====
# 开启后会把模型调用 / 工具调用 / Agent 调用、token 用量与耗时以 OTLP 导出，
# 可在 AgentScope Studio（或 Jaeger、Langfuse 等任意 OTLP 后端）查看。
TRACING_ENABLED=false
# Studio 的 OTLP/gRPC 端点（默认 4317）；若改用 http 协议则填其 Web 端口，程序会自动补 /v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=friday-agent

# ===== 联网搜索（「联网搜索」开关，检索由 mcp-server 执行，服务地址与密钥都在 mcp-server 侧配置）=====
# MCP 服务端点（由根目录 ./start.sh 以 HTTP 模式拉起，默认 127.0.0.1:8806）
# MCP_SERVER_URL=http://127.0.0.1:8806/mcp
# 与 mcp-server/.env 的 MCP_AUTH_TOKEN 保持一致；服务端未配鉴权则留空
# MCP_AUTH_TOKEN=

# ===== GLM 直连（长期记忆抽取 / 滚动摘要，复用 ZHIPU_API_KEY）=====
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 记忆抽取与滚动摘要使用的 GLM 模型（glm-5.3-flash 低价档；可换 glm-4.7-flash 免费档）
# GLM_MODEL=glm-5.3-flash
