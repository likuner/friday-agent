APP_ENV=development
DATABASE_URL=postgresql+asyncpg://friday:friday@localhost:5432/friday_agent
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000

# ===== 模型 =====
# MODEL_PROVIDER=demo 时返回本地演示流，无需任何密钥；真正调用模型设为 deepseek
MODEL_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
# 深度思考模型，需支持 reasoning（如 deepseek-v4-flash）；留空则退化为提示词引导
OPENAI_THINKING_MODEL=deepseek-v4-flash

# ===== 医学 RAG（需要独立的 pgvector 实例，见项目根 README）=====
ZHIPU_API_KEY=
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
# 需与文献语料入库时的维度一致
EMBEDDING_DIMENSIONS=1024
MEDRAG_DB_URL=postgresql://meduser:medpass@localhost:5433/medrag
RAG_TOP_K=4
RAG_MIN_SCORE=0.0

# ===== 可观测：OpenTelemetry 追踪 =====
# 开启后会把模型调用 / 工具调用 / Agent 调用、token 用量与耗时以 OTLP 导出，
# 可在 AgentScope Studio（或 Jaeger、Langfuse 等任意 OTLP 后端）查看。
TRACING_ENABLED=false
# Studio 的 OTLP/gRPC 端点（默认 4317）；若改用 http 协议则填其 Web 端口，程序会自动补 /v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=friday-agent

# ===== 联网搜索（「联网搜索」开关，由 GLM 内置联网检索执行，复用 ZHIPU_API_KEY）=====
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 执行联网检索的 GLM 模型（glm-4-flash 免费；可换 glm-4-air 等提升摘要质量）
# GLM_MODEL=glm-4-flash
# 搜索引擎：search_std 0.01元/次；search_pro 0.03元/次（质量更好）
# GLM_SEARCH_ENGINE=search_std
